{
  "db_dir": "~/.hermes/data/hermes_kb",
  "watch_dirs": [
    "~/knowledge_base",
    "~/.hermes/skills"
  ],
  "embedding": {
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key": "",
    "model": "BAAI/bge-m3",
    "dimensions": 1024,
    "batch_size": 12,
    "timeout": 30
  },
  "reranker": {
    "base_url": "https://api.siliconflow.cn/v1/rerank",
    "api_key": "",
    "model": "BAAI/bge-reranker-v2-m3"
  },
  "chunker": {
    "min_chunk_chars": 200,
    "max_chunk_chars": 1500,
    "target_chunk_chars": 800
  },
  "source_filters": {
    "exclude_dirs": [
      ".archive",
      "__pycache__",
      ".git"
    ],
    "exclude_file_prefixes": [
      ".tmp",
      ".usage-",
      ".usage_"
    ],
    "exclude_component_substrings": [
      ".rollback-"
    ],
    "exclude_paths": [],
    "exclude_path_prefixes": [],
    "exclude_file_suffixes": [
      ".bak",
      ".part",
      ".tmp",
      ".swp"
    ]
  },
  "retrieval": {
    "candidate_limit": 25,
    "fts_candidate_limit": 15,
    "rrf_k": 60,
    "rerank_top_n": 25,
    "min_rerank_score": 0.65,
    "use_reranker": true,
    "rank_by": "hybrid",
    "hybrid_rank_threshold": 0.9,
    "reranker_max_candidates": 25
  }
}
